# Copy to .env and set your own provider keys before using live mode.
# Never commit .env or a provider key.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional model defaults. Eleven v4 supports Malayalam speech.
OPENAI_MODEL=gpt-4.1-mini
ELEVENLABS_TTS_MODEL=eleven_v4
# Choose a Malayalam-capable voice from your own ElevenLabs account.
ELEVENLABS_VOICE_ID=

# Optional local demo settings.
UI_PORT=4177
WORLD_ID=demo-world
PLAYER_ID=demo-player
TURN_TIMEOUT_MS=30000
MAX_AUDIO_SECONDS=15
MAX_AUDIO_BYTES=4194304
LIVE_TURN_LIMIT=25
# Defaults to %LOCALAPPDATA%\MalayalamNpcDemo\data on Windows.
# DATA_DIR=C:\Users\YourName\AppData\Local\MalayalamNpcDemo\data
