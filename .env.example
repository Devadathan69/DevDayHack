# Copy to .env and set your own provider keys before using live mode.
# Never commit .env or a provider key.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional model defaults. Eleven v4 supports Malayalam speech.
OPENAI_MODEL=gpt-5.4-mini
ELEVENLABS_TTS_MODEL=eleven_v4
# Choose a Malayalam-capable voice from your own ElevenLabs account.
ELEVENLABS_VOICE_ID=
# Optional account-approved named pools: JSON arrays of {"name":"Label","voiceId":"YOUR_ID"}.
# Native NPCs rotate pool voices deterministically; known genders use matching names.
# Unknown native gender uses the male pool with an original neutral name; browser Manu keeps the default.
# Keep actual approved IDs only in ignored .env. Pools take precedence over legacy single overrides.
ELEVENLABS_MALE_VOICES=[]
ELEVENLABS_FEMALE_VOICES=[]
# Optional legacy single-voice fallbacks when the matching pool is empty.
ELEVENLABS_MALE_VOICE_ID=
ELEVENLABS_FEMALE_VOICE_ID=

# Optional local demo settings.
UI_PORT=4177
WORLD_ID=demo-world
PLAYER_ID=demo-player
TURN_TIMEOUT_MS=30000
MAX_AUDIO_SECONDS=15
MAX_AUDIO_BYTES=4194304
# 0 disables the app's per-run cap; provider quotas, timeouts, and audio limits still apply.
LIVE_TURN_LIMIT=0
# Defaults to %LOCALAPPDATA%\MalayalamNpcDemo\data on Windows.
# DATA_DIR=C:\Users\YourName\AppData\Local\MalayalamNpcDemo\data
